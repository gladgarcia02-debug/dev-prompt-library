# Express API port
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dev_prompt_library

# Allowed browser origin for the frontend
CLIENT_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional Google OAuth credentials. Register this exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
